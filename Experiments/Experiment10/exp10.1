CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    emp_name VARCHAR(100),
    salary NUMERIC(10,2)
);

INSERT INTO Employee VALUES
(1, 'John', 50000),
(2, 'Alice', 75000),
(3, 'Bob', 60000),
(4, 'David', 90000),
(5, 'Emma', 80000);

SELECT salary
FROM (
    SELECT DISTINCT salary
    FROM Employee
    ORDER BY salary DESC
    LIMIT 2 OFFSET 1
) AS highest_salaries
ORDER BY salary DESC;