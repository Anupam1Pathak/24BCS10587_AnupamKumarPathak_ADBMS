CREATE TABLE Salary_Hike (
    emp_id INT PRIMARY KEY,
    emp_name VARCHAR(100),
    salary NUMERIC(10,2)
);

INSERT INTO Salary_Hike VALUES
(1, 'John', 50000),
(2, 'Alice', 60000);

CREATE OR REPLACE FUNCTION check_salary_hike()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.salary > OLD.salary * 1.15 THEN
        RAISE EXCEPTION 'Salary increase cannot exceed 15%% of the current salary.';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_check_salary_hike
BEFORE UPDATE ON Salary_Hike
FOR EACH ROW
EXECUTE FUNCTION check_salary_hike();

UPDATE Salary_Hike
SET salary = 55000
WHERE emp_id = 1;

UPDATE Salary_Hike
SET salary = 72000
WHERE emp_id = 2;